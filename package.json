{
  "name": "motor-calculo-eng-civil",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "postinstall": "npm run prepare:runtime",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run prepare:runtime && npm run typecheck && vite build",
    "provision": "bash scripts/provision.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "jsxgraph": "1.13.3",
    "katex": "0.18.7",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
